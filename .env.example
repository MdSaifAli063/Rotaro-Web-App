RAZORPAY_PRO_ANNUAL_PLAN_ID="plan_your_pro_annual_id"
RAZORPAY_BUSINESS_MONTHLY_PLAN_ID="plan_your_business_monthly_id"
RAZORPAY_BUSINESS_ANNUAL_PLAN_ID="plan_your_business_annual_id"

# EmailJS client-side email delivery
# Set these in Vercel Project Settings -> Environment Variables.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_WELCOME_TEMPLATE_ID=
VITE_EMAILJS_LEAVE_TEMPLATE_ID=
