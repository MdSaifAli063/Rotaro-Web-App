{
  "version": 3,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|svg|ico|json|map))",
      "dest": "/dist/client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/src/server.ts"
    }
  ]
}
